# Which backend the app talks to: local or preview use the in-memory mock;
# test, production, or anything else (or nothing) uses Supabase.
APP_ENV=local

# The mock's login details are in src/lib/auth/test-user.ts.
# Logging in as unavailable@example.com shows the "Can't log in right now" popup.

# Only needed when APP_ENV picks Supabase.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
